<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/146.0.0.0 Safari/537.36" version="29.6.6">
  <diagram name="Page-1" id="bBeNJY_eomh04KZ7eJCx">
    <mxGraphModel dx="16360" dy="5620" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n      subgraph DATA[\&quot;数据加载\&quot;]\n          RAW[\&quot;EHR 原始数据&lt;br/&gt;(CustomDataset)\&quot;]\n          COL[\&quot;collate_fn&lt;br/&gt;pad_sequence + 组 batch\&quot;]\n          DL[\&quot;DataLoader&lt;br/&gt;(RandomSampler)\&quot;]\n          RAW --&gt; COL --&gt; DL\n      end\n\n      DL --&gt;|\&quot;batch: x(B,T,V), mask(B,T,V),&lt;br/&gt;time(B,T), lens(B,), labels\&quot;| PRETRAIN\n      DL --&gt;|\&quot;batch: x(B,T,V), mask(B,T,V),&lt;br/&gt;time(B,T), lens(B,), labels\&quot;| FINETUNE\n\n      subgraph PRETRAIN[\&quot;Pre-train 阶段 (main_pretrain.py)\&quot;]\n          direction TB\n\n          P_MNAR_DROP[\&quot;MNAR Dropout&lt;br/&gt;original_mask = apply_mnar_dropout(mask, rate)\&quot;]\n\n          subgraph TARGET_PATH[\&quot;Target 分支 (no_grad)\&quot;]\n              TE[\&quot;Target Encoder&lt;br/&gt;(SMILELeanEncoder 深拷贝)&lt;br/&gt;requires_grad=False\&quot;]\n              TE_OUT[\&quot;h: (B, V, T+1, d)\&quot;]\n              TE --&gt; TE_OUT\n          end\n\n          subgraph MASK_STRATEGY[\&quot;分层掩码策略 (Scheme F+D)\&quot;]\n              MS_RAND[\&quot;random_masking&lt;br/&gt;全局均匀采样 ratio\&quot;]\n              MS_TEMP[\&quot;temporal_block_masking&lt;br/&gt;随机连续时间块\&quot;]\n              MS_SYS[\&quot;system_level_masking&lt;br/&gt;生理系统组变量块\&quot;]\n              MS_SCHED[\&quot;_build_stratified_schedule&lt;br/&gt;按数据集比例分配每 batch 策略&lt;br/&gt;C12: sys30%/temp25%/rand45%\&quot;]\n              MS_SCHED --&gt; MS_RAND &amp; MS_TEMP &amp; MS_SYS\n          end\n\n          P_MASK_OUT[\&quot;x_masked(B,T,V)&lt;br/&gt;visible_mask(B,T,V)&lt;br/&gt;pretrain_mask(B,T,V)\&quot;]\n\n          subgraph ENCODER_PATH[\&quot;Online Encoder 分支\&quot;]\n              ENC[\&quot;SMILELeanEncoder&lt;br/&gt;(详见下方 Encoder 子图)\&quot;]\n              ENC_OUT[\&quot;z_enc: (B, V, T+1, d)\&quot;]\n              PRED[\&quot;EmbeddingDecoder&lt;br/&gt;MLP(d-&gt;4d-&gt;d) + proj_out(d-&gt;d)\&quot;]\n              PRED_OUT[\&quot;z: (B, V, T+1, d)\&quot;]\n              ENC --&gt; ENC_OUT --&gt; PRED --&gt; PRED_OUT\n          end\n\n          P_LOSS[\&quot;Smooth L1 Loss&lt;br/&gt;仅在 pretrain_mask=1 位置计算&lt;br/&gt;跳过 CLS (t=0)\&quot;]\n          P_EMA[\&quot;EMA 更新 Target Encoder&lt;br/&gt;theta_t = m*theta_t + (1-m)*theta_e&lt;br/&gt;m: 0.996 -&gt; 1.0 线性增长\&quot;]\n          P_OPTIM[\&quot;Adam Optimizer&lt;br/&gt;更新 encoder + predictor\&quot;]\n\n          P_MNAR_DROP --&gt; TARGET_PATH\n          P_MNAR_DROP --&gt; MASK_STRATEGY\n          MASK_STRATEGY --&gt; P_MASK_OUT\n          P_MASK_OUT --&gt; ENCODER_PATH\n          PRED_OUT --&gt; P_LOSS\n          TE_OUT --&gt; P_LOSS\n          P_LOSS --&gt;|\&quot;loss.backward()\&quot;| P_OPTIM\n          P_OPTIM --&gt;|\&quot;step()\&quot;| ENC\n          P_OPTIM -.-&gt;|\&quot;EMA\&quot;| P_EMA\n          P_EMA -.-&gt; TE\n      end\n\n      subgraph FINETUNE[\&quot;Fine-tune 阶段 (main_finetune.py)\&quot;]\n          direction TB\n\n          F_MNAR[\&quot;MNAR Dropout&lt;br/&gt;训练: apply_mnar_dropout(mask)&lt;br/&gt;验证/测试: clean mask\&quot;]\n          F_FREEZE[\&quot;Freeze 阶段判断&lt;br/&gt;epoch &lt;= freeze_epochs(5):&lt;br/&gt;  encoder no_grad\&quot;]\n\n          F_ENC[\&quot;SMILELeanEncoder&lt;br/&gt;(加载预训练 checkpoint-mse.pth)\&quot;]\n          F_ENC_OUT[\&quot;h: (B, V, T+1, d)\&quot;]\n\n          F_CLS[\&quot;Classifier&lt;br/&gt;h[:,:,0,:] -&gt; CLS tokens&lt;br/&gt;reshape(B, V*d) -&gt; Linear(V*d, num_class)\&quot;]\n          F_LOGITS[\&quot;logits: (B, num_class)\&quot;]\n\n          F_LOSS[\&quot;CrossEntropyLoss&lt;br/&gt;(加权: c12/c19/LOS)&lt;br/&gt;(无权重: mortality/decompensation)&lt;br/&gt;或 BCEWithLogitsLoss (phenotyping)\&quot;]\n          F_OPTIM[\&quot;Adam + CosineAnnealingLR&lt;br/&gt;更新 encoder + classifier\&quot;]\n          F_SAVE[\&quot;保存 best checkpoint-prc.pth&lt;br/&gt;按 save_metric (auprc/auc_macro)\&quot;]\n\n          F_MNAR --&gt; F_FREEZE --&gt; F_ENC --&gt; F_ENC_OUT --&gt; F_CLS --&gt; F_LOGITS --&gt; F_LOSS\n          F_LOSS --&gt;|\&quot;loss.backward()\&quot;| F_OPTIM\n          F_OPTIM --&gt;|\&quot;step()\&quot;| F_ENC &amp; F_CLS\n          F_LOSS -.-&gt; F_SAVE\n      end\n\n      subgraph SMILE_ENC[\&quot;SMILELeanEncoder 内部架构 (smart.py)\&quot;]\n          direction TB\n\n          S_DENSITY[\&quot;局部观测密度计算&lt;br/&gt;avg_pool1d(original_mask, ws=5)&lt;br/&gt;因果(LOS/Decomp): 仅左填充&lt;br/&gt;双向(其他): 对称填充&lt;br/&gt;-&gt; density(B,T,V)\&quot;]\n\n          S_EMBED[\&quot;DensityMLPEmbedder&lt;br/&gt;stack(value,mask,density) -&gt; (B,T,V,3)&lt;br/&gt;Linear(3,d) -&gt; Linear(d,d)&lt;br/&gt;permute -&gt; (B,V,T,d)\&quot;]\n\n          S_CLS[\&quot;CLS Token 拼接&lt;br/&gt;query(V,1,d) cat x&lt;br/&gt;-&gt; (B, V, T+1, d)\&quot;]\n\n          S_PE1[\&quot;正弦索引 PE&lt;br/&gt;PositionalEncoding(d, max_len+1)&lt;br/&gt;+ pos_table[:, :T+1]\&quot;]\n\n          S_TIME[\&quot;TimeEncoder&lt;br/&gt;w=learnable freq (half_dim)&lt;br/&gt;Phi(t) = [sin(wt), cos(wt)]&lt;br/&gt;-&gt; time_enc(B, T+1, time_dim)\&quot;]\n\n          S_PE2[\&quot;物理时间 PE (零初始化)&lt;br/&gt;time_pe_proj(time_enc) -&gt; (B,1,T+1,d)&lt;br/&gt;x = x + time_pe\&quot;]\n\n          S_MNAR[\&quot;MNARCooccurrenceEncoder (零参数)&lt;br/&gt;co_occur = miss^T @ miss / T&lt;br/&gt;- marginal_i * marginal_j&lt;br/&gt;-&gt; mnar_cooccur(B, V, V)\&quot;]\n\n          subgraph BLOCKS[\&quot;SMILELeanBasicBlock x L (e_layers=2)\&quot;]\n              direction TB\n              B_SEQ[\&quot;SeqAttBlock&lt;br/&gt;reshape(B,V,T+1,d)-&gt;(B*V,T+1,d)&lt;br/&gt;各变量独立时序 Self-Attention&lt;br/&gt;mask-aware attention bias\&quot;]\n              B_VAR[\&quot;MNARBiasFiLMVarAttBlock&lt;br/&gt;1. MNAR bias: scale(heads,V,V)*cooccur(B,V,V)&lt;br/&gt;2. time_decay: sigmoid(proj(time_enc)) per-timestep&lt;br/&gt;3. 5D Attn: Q=CLS, \n  K=mask-mean, V=time-concat&lt;br/&gt;4. FiLM: (1+gamma)*attn_out + beta&lt;br/&gt;   gamma,beta = film_gen(time_enc)\&quot;]\n              B_MLP[\&quot;MLPBlock&lt;br/&gt;LayerNorm + FFN(d-&gt;4d-&gt;d) + Residual\&quot;]\n              B_SEQ --&gt; B_VAR --&gt; B_MLP\n          end\n\n          S_DENSITY --&gt; S_EMBED --&gt; S_CLS --&gt; S_PE1 --&gt; S_PE2\n          S_TIME --&gt; S_PE2\n          S_TIME --&gt; BLOCKS\n          S_MNAR --&gt; BLOCKS\n          S_PE2 --&gt; BLOCKS\n          BLOCKS --&gt; S_OUT[\&quot;输出: (B, V, T+1, d)\&quot;]\n      end\n\n      PRETRAIN -.-&gt;|\&quot;checkpoint-mse.pth&lt;br/&gt;(encoder weights)\&quot;| FINETUNE&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="8vZCLfAi3DKS2MPhjQzh-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;imageAspect=1;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="6877" width="1986.203125" x="190" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
